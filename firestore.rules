rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Validation Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'name', 'amount', 'week']) &&
             data.id is number && data.id >= 1 && data.id <= 24 &&
             data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
             data.amount is number && data.amount >= 0 && data.amount <= 100000000 &&
             data.week is number && data.week >= 0;
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'amount', 'changeType', 'createdAt']) &&
             data.studentId is number && data.studentId >= 1 && data.studentId <= 24 &&
             data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 100 &&
             data.amount is number && data.amount > 0 && data.amount <= 100000000 &&
             data.changeType in ['ADD', 'DECREASE'];
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['title', 'amount', 'createdAt']) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 150 &&
             data.amount is number && data.amount > 0 && data.amount <= 100000000;
    }

    // Students Collection: Public read, writes validated
    match /students/{studentId} {
      allow get, list: if true;
      allow create, update: if isValidId(studentId) && isValidStudent(request.resource.data);
      allow delete: if false;
    }

    // Payments Collection (Immutable Ledger): Public read, creation validated
    match /payments/{paymentId} {
      allow get, list: if true;
      allow create: if isValidId(paymentId) && isValidPayment(request.resource.data);
      allow update, delete: if false;
    }

    // Expenses Collection: Public read, creation and deletion validated
    match /expenses/{expenseId} {
      allow get, list: if true;
      allow create: if isValidId(expenseId) && isValidExpense(request.resource.data);
      allow delete: if isValidId(expenseId);
      allow update: if false;
    }

    // Settings Collection: Store synchronized passwords configuration
    match /settings/{settingId} {
      allow get, list: if true;
      allow create, update: if isValidId(settingId);
      allow delete: if false;
    }
  }
}

